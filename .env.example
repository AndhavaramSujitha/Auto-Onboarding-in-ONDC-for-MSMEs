# .env.example
# Copy this to .env and fill in the values
# JWT secret for signing tokens (keep secret)
JWT_SECRET=ChangeMeSecret
# JWT expiration in ms (default 86400000 = 1 day)
JWT_EXPIRATION_MS=86400000

# MongoDB connection URI (use your Atlas M0 free tier)
MONGODB_URI=mongodb://localhost:27017/ondc_auto_onboarder

# Groq API key (free tier). Obtain from https://console.groq.com
GROQ_API_KEY=your-groq-api-key
